class Solution {
public:
    int minimumArea(vector<vector<int>>& grid) {
        int left = INT_MAX;
        int right = INT_MIN;
        int top = INT_MAX;
        int bottom = INT_MIN;

        for(int row = 0; row < grid.size(); row++){
            for(int col = 0; col < grid[0].size(); col++){
                if(grid[row][col] == 1){
                    left = min(left, col);
                    right = max(right, col);
                    top = min(top, row);
                    bottom = max(bottom, row);
                }
            }
        }

        if (left == INT_MAX) return 0;

        int area = (right - left + 1) * (bottom - top + 1);
        return area;
    }
};
