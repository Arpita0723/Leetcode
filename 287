class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        int i=0;
        int n=nums.size();
        while(i<n){
            int correctidx=nums[i];
            if(i==nums[i])i++;
            else if(nums[i]!=nums[correctidx]){
                swap(nums[i],nums[correctidx]);
            }
            else{
                return nums[i];
            }
        }
        return -1;
    }
};
