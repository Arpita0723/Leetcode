class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
        if(head==NULL || head->next==NULL)return head;
        int len=0;
        ListNode* t=head;
        while(t->next!=NULL){
            len++;
            t=t->next;
        }
        len+=1;
        k=k%len;
        if(k==0)return head;
        ListNode* p=head;
        ListNode* m=NULL;
        for(int i=0;i<len-k;i++){
            m=p;
            p=p->next;
        }
        if(m)m->next=NULL;
        t->next=head;
        head=p;
        return head;
    }
};
