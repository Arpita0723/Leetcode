class Solution {
public:
    bool isValid(string s) {
        stack<char>st;
        bool found=true;
        for(int i=0;i<s.length();i++){
             if(s[i]=='(' || s[i]=='{' || s[i]=='['){
                st.push(s[i]);
             }
             else if(s[i]==')' && !st.empty() &&  st.top()=='(')st.pop();
             else if(s[i]=='}' && !st.empty() &&  st.top()=='{')st.pop();
             else if(s[i]==']' && !st.empty() &&  st.top()=='[')st.pop();
             else{
                found=false;
                break;
             }
        }
        if(found==false)return false;
        else return st.size()==0;
    }
};
