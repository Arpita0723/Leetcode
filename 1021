class Solution {
public:
    string removeOuterParentheses(string s) {
        string r="";
        int depth=0;
        int i=0;
        while(i<s.length()){
            if(s[i]=='('){
                depth++;
                if(depth>1){
                    r+='(';
                }
            }
            else{
                depth--;
                if(depth>0){
                    r+=')';
                }
            } 
            i++;                                 
        }
        return r;
    }
};
