class Solution {
public:
    int gf(int n){
        int ans=1;
        for(int i=2;i<=sqrt(n);i++){
            if(n%i==0){
                ans=n/i;
                break;
            }
        }
        return ans;
    }
    bool isPrime(int n){
        if(n<2)return false;
        for(int i=2;i*i<=n;i++){
            if((n%i)==0){
                return false;
            }
    }
    return true;}
    int minSteps(int n) {
        int c=0;
        while(n>1){
            if(isPrime(n)){
                c+=n;
                break;
            }
            int hf=gf(n);
            c+=n/hf;
            n=hf;
        }
        return c;
    }
};
