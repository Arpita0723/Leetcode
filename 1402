class Solution {
public:
    int maxSatisfaction(vector<int>& satisfaction) {
        int n=satisfaction.size();
        sort(satisfaction.begin(),satisfaction.end());
        int suffsum=0;
        int result=0;
        for(int i=n-1;i>=0;i--){
            suffsum+=satisfaction[i];
            if(suffsum>0){
                result+=suffsum;
            }
            else{
                break;
            }
        }
        return result;
    }
};
