class Solution {
public:
    int reverseNum(int n) {
        int num = 0;
        while (n > 0) {
            int r = n % 10;
            n /= 10;
            num = num * 10 + r;
        }
        return num;
    }

    int countDistinctIntegers(vector<int>& nums) {
        int n = nums.size();  // store original size
        for (int i = 0; i < n; i++) {
            nums.push_back(reverseNum(nums[i]));
        }
        unordered_set<int> s(nums.begin(), nums.end());
        return s.size();
    }
};
