class Solution {
public:
    int numSubarrayProductLessThanK(vector<int>& nums, int k) {
        if(k<=1)return 0;
        int i=0;
        int n=nums.size();
        int j=0;
        int p=1;
        int count=0;
        while(j<n){
            p*=nums[j];
            while(p>=k){
                 count+=j-i;
                 p/=nums[i];
                 i++;
            }
            j++;
        }
        while(i<n){
             count+=j-i;
             p/=nums[i];
             i++;
        }
        return count;
    }
};
