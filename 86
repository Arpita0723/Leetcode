class Solution {
public:
    ListNode* partition(ListNode* head, int x) {
        if(head==NULL || head->next==NULL)return head;
        ListNode* dummy=new ListNode(-1);
        ListNode* t=dummy;
        ListNode* p=head;
        while(p){
              if(p->val<x){
                t->next=new ListNode(p->val);
                t=t->next;
              }
              p=p->next;
        }
        while(head){
             if(head->val>=x){
                  t->next=new ListNode(head->val);
                  t=t->next;
             }
              head=head->next;
        }
        return dummy->next;
    }
};
