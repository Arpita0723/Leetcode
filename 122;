class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        vector<int>prev(2,0),curr(2,0);
        for(int idx=n-1;idx>=0;idx--){
                curr[1]=max(-prices[idx]+prev[0],prev[1]);
                curr[0]=max(prices[idx]+prev[1],prev[0]);
                prev=curr;
            }
        return curr[1];
    }
};
