class Solution {
public:
    int numberOfSubstrings(string s) {
        int n=s.length();
        int left=0;
        int cnt=0;
        int ca = 0, cb = 0, cc = 0;
        for(int right=0;right<n;right++){
            if(s[right]=='a')ca++;
            else if(s[right]=='b')cb++;
            else cc++;
            while(ca>=1 && cb>=1 && cc>=1){
                cnt+=n-right;
                if(s[left]=='a')ca--;
                else if(s[left]=='b')cb--;
                else cc--;
                left++;
            }
        }
        return cnt;
    }
};
