class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
        int s=0;
        int ans=0;
        for(int i=0;i<nums.size();i++){
            if(nums[i]==1){
               s++;
               ans=max(ans,s);
            }
            else{
                s=0;
            }
        }
        return ans;
    }
};
