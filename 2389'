class Solution {
public:
    vector<int> answerQueries(vector<int>& nums, vector<int>& queries) {
        int n = nums.size();
        int m = queries.size();
        sort(nums.begin(), nums.end());

        vector<int> pre(n, 0);
        pre[0] = nums[0];
        for(int i=1; i<n; i++){
            pre[i] = pre[i-1] + nums[i];
        }

        vector<int> ans;
        for(int i=0; i<m; i++){
            int low = 0;
            int high = n-1;
            int maxlen = -1;  // reset for each query

            while(low <= high){
                int mid = low + (high - low)/2;
                if(pre[mid] > queries[i]){
                    high = mid - 1;
                } else {
                    maxlen = mid;
                    low = mid + 1;
                }
            }

            ans.push_back(maxlen + 1);  // number of elements
        }

        return ans;
    }
};
