class Solution {
public:
    bool check(string &s1,string &s2){
        if(s1.size()!=s2.size()+1)return false;
        int first=0;
        int sec=0;
        while(first<s1.size()){
            if(s1[first]==s2[sec]){
                first++;
                sec++;
            }
            else{
                first++;
            }
        }
        if(first==s1.size() && sec==s2.size())return true;
        else return false;
    }
    int longestStrChain(vector<string>& arr) {
        int n=arr.size();
        vector<int>dp(n,1);
        sort(arr.begin(),arr.end(),[](string &s1,string &s2){
            return s1.size()<s2.size();
        });
        int maxi=1;
        for(int i=0;i<n;i++){
            for(int j=0;j<i;j++){
                if(check(arr[i],arr[j])&&(1+dp[j]>dp[i])){
                    dp[i]=1+dp[j];
                }
            }
            if(dp[i]>maxi)maxi=dp[i];
        }
        return maxi;
    }
};
