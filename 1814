class Solution {
public:
    int reverse(int n){
        int num=0;
        while(n>0){
            int r=n%10;
            n/=10;
            num*=10;
            num+=r;
        }
        return num;
    }
    int countNicePairs(vector<int>& nums) {
        map<int,long long>mp;
        const int m=1e9+7;
        long long ans=0;
        for(int i=0;i<nums.size();i++){
            long long x=nums[i]-reverse(nums[i]);
            ans+=mp[x]%m;
            mp[x]++;
        }
        
    return ans%m;}
};
