class Solution {
public:
    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {
        if(headA==NULL || headB==NULL) return NULL;
        stack<ListNode*>st;
        stack<ListNode*>pt;
        while(headA!=NULL){
            st.push(headA);
            headA=headA->next;
        }
        while(headB!=NULL){
            pt.push(headB);
            headB=headB->next;
        }
        ListNode* curr=NULL;
        while(!st.empty() && !pt.empty() && st.top()==pt.top()){
              curr=st.top();
              st.pop();
              pt.pop();
        }
        if(curr!=NULL)return curr;
        return NULL;
    }
};
