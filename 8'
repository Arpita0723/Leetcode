class Solution {
public:
    int helper(string s,int i,long long num,int sign){
        if(i>=s.length())return (int)num*sign;

        char c=s[i];
        if(c < '0' || c > '9') return (int)(num * sign);
        int p = c - '0';

        if(num > (INT_MAX - p) / 10)
            return sign == 1 ? INT_MAX : INT_MIN;

        num = num * 10 + p;
        return helper(s, i + 1, num, sign);
    }
    int myAtoi(string s) {
        int i=0;
        while(i<s.length() && s[i]==' ')i++;
        int sign=1;
        if(i<s.length() && (s[i]=='+' ||  s[i]=='-')){
            if(s[i]=='-')sign=-1;
            i++;
        }
        return helper(s,i,0,sign);
    }
};
