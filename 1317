class Solution {
public:
    bool check(int a) {
        while (a > 0) {
            if (a % 10 == 0) return false; // invalid if digit is zero
            a /= 10;
        }
        return true;
    }

    vector<int> getNoZeroIntegers(int n) {
        for (int i = 1; i < n; i++) {
            int a = i;
            int b = n - i;
            if (check(a) && check(b)) {
                return {a, b};
            }
        }
        return {};
    }
};
