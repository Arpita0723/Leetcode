class Solution {
public:
    vector<int> findDiagonalOrder(vector<vector<int>>& mat) {
        vector<int>ans;
        int m =mat.size();
        int n=mat[0].size();
        for(int sum=0;sum<=m+n-2;sum++){
        if(sum%2==0){
            for(int i=min(m-1,sum);i>=0;i--){
                int j=sum-i;
                if(j>=0 && j<n){
                    ans.push_back(mat[i][j]);
                }
            }
        }
        else{
            for(int j=min(sum,n-1);j>=0;j--){
                int i=sum-j;
                if(i>=0 && i<m){
                    ans.push_back(mat[i][j]);
                }
            }
        }
        }
        return ans;
    }
}; 
