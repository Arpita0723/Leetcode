class Solution {
public:
    int mySqrt(int x) {
        if (x == 0 || x == 1) return x;

        int low = 1, high = x, ans = 0;

        while (low <= high) {
            int mid = low + (high - low) / 2;
            long long square = 1LL * mid * mid;

            if (square == x) {
                return mid; // perfect square
            }
            else if (square < x) {
                ans = mid;       // possible answer, look higher
                low = mid + 1;
            }
            else {
                high = mid - 1;  // too high, go lower
            }
        }

        return ans;
    }
};
