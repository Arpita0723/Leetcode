class Solution {
public:
    int bestClosingTime(string customers) {
        int n = customers.size();
        vector<int> prefn(n+1, 0);
        vector<int> suffy(n+1, 0);

        // prefix: # of N before or at position i
        for(int i=0;i<n;i++){
            prefn[i+1] = prefn[i] + (customers[i] == 'N');
        }

        // suffix: # of Y after or at position i
        for(int i=n-1;i>=0;i--){
            suffy[i] = suffy[i+1] + (customers[i] == 'Y');
        }

        int minPenalty = INT_MAX;
        int bestHour = 0;

        // shop can close at hours 0..n
        for(int i=0;i<=n;i++){
            int penalty = prefn[i] + suffy[i];
            if(penalty < minPenalty){
                minPenalty = penalty;
                bestHour = i;
            }
        }
        return bestHour;
    }
};
