class Solution {
public:
    int maximumNumberOfStringPairs(vector<string>& words) {
        unordered_set<string>s;
        int ans=0;
        for(int i=0;i<words.size();i++){
            if(words[i][0]!=words[i][1]){
                string x=words[i];
                reverse(x.begin(),x.end());
                if(s.find(x)!=s.end()){
                    s.erase(x);
                    ans++;
                }
                else{
                    s.insert(words[i]);
                }
            }
        }
        return ans;
    }
};
