class Solution {
public:
    bool checkPerfectNumber(int num) {
        int s=0;
        if(num==1)return false;
        for(int i=1;i*i<=num;i++){
            if(num%i==0){
            s+=i;
            if(i>1 && i*i!=num){
                  s+=num/i;}
            }
        }
        return s==num;
    }
};
