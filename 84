class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int n=heights.size();
        vector<int>nsi(n);
        nsi[n-1]=n;
        stack<int>st;
        st.push(n-1);
        for(int i=n-2;i>=0;i--){
            while(st.size()>0 && heights[st.top()]>=heights[i])st.pop();
            if(st.size()==0)nsi[i]=n;
            else nsi[i]=st.top();
            st.push(i);
        }
        vector<int>psi(n);
        psi[0]=-1;
        stack<int>rt;
        rt.push(0);
        for(int i=1;i<n;i++){
            while(rt.size()>0 && heights[rt.top()]>=heights[i])rt.pop();
            if(rt.size()==0)psi[i]=-1;
            else psi[i]=rt.top();
            rt.push(i);
        }
        int maxarea=0;
        for(int i=0;i<n;i++){
            int area = heights[i]*(nsi[i]-psi[i]-1);
            maxarea=max(maxarea,area);
        }
        return maxarea;
    }
};
