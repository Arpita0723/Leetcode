class Solution {
public:
    int longestOnes(vector<int>& nums, int k) {
        int n=nums.size();
        int i=0;
        int j=0;
        int flips=0;
        int maxlen=INT_MIN;
        while(j<n){
            if(nums[j]==1)j++;
            else{
                if(flips<k){
                    flips++;
                    j++;
                }
                else{
                    int len=j-i;
                    maxlen=max(maxlen,len);
                    while(nums[i]==1)i++;
                    i++;
                    j++;
                }
            }
            maxlen=max(j-i,maxlen);
        }
        return maxlen;
    }
};
