class Solution {
public:
    int trap(vector<int>& a) {
        int n=a.size();
    vector<int>prev(n);
    prev[0]=-1;
    int max=a[0];
    for(int i=1;i<n;i++){
       prev[i]=max;
       if(a[i]>max)max=a[i];
    }
    prev[n-1]=-1;
    max=a[n-1];
    for(int i=n-2;i>=0;i--){
       if(prev[i]>max)prev[i]=max;
       if(a[i]>max)max=a[i];
    }
   
    int sum=0;
    for(int i=1;i<n-1;i++){
        if(a[i]<prev[i]){
            sum+=prev[i]-a[i];
        }
    }
    return sum;
    }
};
