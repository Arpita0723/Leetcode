class Solution {
public:
    int numberOfSubarrays(vector<int>& nums, int k) {
        int n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]%2==0)nums[i]=0;
            else nums[i]=1;
        }
        unordered_map<int,int>freq;
        int curr_sum=0;
        int cnt=0;
        freq[0]=1;
        for(int i=0;i<n;i++){
           curr_sum+=nums[i];
           if(freq.find(curr_sum-k)!=freq.end()){
                 cnt+=freq[curr_sum-k];
           }
           freq[curr_sum]++;
        }
        return cnt;
    }
};
