class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        vector<vector<int>>prev(2,vector<int>(3,0)),curr(2,vector<int>(3,0));
        for(int idx=n-1;idx>=0;idx--){
            for(int buy=0;buy<2;buy++){
                for(int cap=1;cap<3;cap++){
                    if(buy)curr[buy][cap]=max(-prices[idx]+prev[0][cap],prev[1][cap]);
                    else curr[buy][cap]=max(prices[idx]+prev[1][cap-1],prev[0][cap]);
                    prev=curr;
                }
            }
        }
        return curr[1][2];
    }
};
