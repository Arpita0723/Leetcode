class Solution {
public:
    bool check(vector<int>&bloomDay,int d,int m,int k){
         int i=0;
         int noofb=0;
         int count=0;
         while(i<bloomDay.size()){
             if(bloomDay[i]<=d){
                count++;
             }
             else{
                count=0;
             }
             if(count==k){
                noofb++;
                count=0;
             }
             i++;
         }
        return noofb>=m;
    }
    int minDays(vector<int>& bloomDay, int m, int k) {
        if(1LL*m*k>bloomDay.size())return -1;
        int a=*min_element(bloomDay.begin(),bloomDay.end());
        int b=*max_element(bloomDay.begin(),bloomDay.end());
        int low=a;
        int high=b;
        int ans=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(check(bloomDay,mid,m,k)){
                ans=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return ans;
    }
};
