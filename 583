class Solution {
public:
    int lcs(string text1, string text2) {
        int i=text1.size()-1;
        int j=text2.size()-1;
        vector<int>prev(text2.size(),0);
        for(int j=0;j<text2.size();j++){
            if(text1[0]==text2[j])prev[j]=1;
            else if(j>0)prev[j]=prev[j-1];
        }
        for(int i=1;i<text1.size();i++){
            vector<int>curr(text2.size(),0);
            if(text1[i]==text2[0])curr[0]=1;
            else if(i>0)curr[0]=prev[0];
            for(int j=1;j<text2.size();j++){
                if(text1[i]==text2[j]) curr[j]=1+prev[j-1];
                else curr[j]= max(prev[j],curr[j-1]); 
            }
            prev=curr;
        }
        return prev[text2.size()-1];
    }
    int minDistance(string word1, string word2) {
        int ans=word1.size()+word2.size()-2*(lcs(word1,word2));
        return ans;
    }
};
