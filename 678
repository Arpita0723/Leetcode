class Solution {
public:
    bool checkValidString(string s) {
        int low=0;
        int high=0;
        int i=0;
        while(i<s.length()){
            if(s[i]=='('){
                low++;
                high++;
            }
            else if(s[i]==')'){
                low--;
                high--;
            }
            else {
                low--;
                high++;
            }
            i++;
        if(high<0)return false;
        if(low<0)low=0;}
        return low==0;
    }
};
