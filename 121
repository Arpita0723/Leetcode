class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int ans=0;
        int i=0;
        int cost=INT_MAX;
        while(i<prices.size()){
            if(prices[i]<cost){
                cost=prices[i];
                i++;
            }
            else{
                ans=max(ans,prices[i]-cost);
                i++;
            }
        }
      return ans;
    }
};
