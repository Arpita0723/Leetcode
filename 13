class Solution {
public:
    int romanToInt(string s) {
        stack<char>st;
        reverse(s.begin(),s.end());
        int i=0;
        while(s[i]!='\0'){
            st.push(s[i++]);
        }
        int count=0;
        while(!st.empty()){
            char ch=st.top();
            st.pop();
            if(ch=='I'){
                 if(!st.empty() && st.top()=='V'){count+=4;st.pop();}
                 else if(!st.empty() && st.top()=='X'){count+=9;st.pop();}
                 else {count+=1;}
            }
            else if(ch=='X'){
                if(!st.empty() && st.top()=='L'){count+=40;st.pop();}
                else if(!st.empty() && st.top()=='C'){count+=90;st.pop();}
                else{count+=10;}
            }
            else if(ch=='C'){
                if(!st.empty() && st.top()=='D'){count+=400;st.pop();}
                else if(!st.empty() && st.top()=='M'){count+=900;st.pop();}
                else{count+=100;}
            }
            else if(ch=='V'){count+=5;}
            else if(ch=='L'){count+=50;}
            else if(ch=='D'){count+=500;}
            else if(ch=='M'){count+=1000;}
        }
        return count;
    }
};
