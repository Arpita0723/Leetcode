class Solution {
public:
    bool check(vector<int>&nums,int a,int b){
        int i=0;
        int sum=0;
        while(i<nums.size()){
            sum += (nums[i] + a - 1) / a;
            i++;
        }
        return sum<=b;
    }
    int smallestDivisor(vector<int>& nums, int threshold) {
        int low=1;
        int high=*max_element(nums.begin(),nums.end());
        int ans=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(check(nums,mid,threshold)){
                ans=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return ans;
    }
};
