class Solution {
public:
    TreeNode* temp=NULL;
    bool flag=true;
    void inorder(TreeNode* root){
        if(root==NULL)return ;
        inorder(root->left);
        if(temp==NULL)temp=root;
        else{
            if(root->val<=temp->val){
                flag=false;
                return;
            }
            temp=root;
        }
        inorder(root->right);
    }
    bool isValidBST(TreeNode* root) {
        inorder(root);
        return flag;
    }
};
