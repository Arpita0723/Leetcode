class Solution {
public:
    vector<int> findEvenNumbers(vector<int>& digits) {
       vector<int> freq(10, 0);   // frequency array for digits 0-9
        for (int d : digits) freq[d]++;

        vector<int> ans;

        // try all 3-digit even numbers
        for (int i = 100; i <= 998; i += 2) {
            int n = i;
            int l = n % 10; n /= 10;   // ones place
            int m = n % 10; n /= 10;   // tens place
            int f = n;                 // hundreds place

            // make a temporary copy of frequency
            vector<int> temp = freq;

            // check availability of digits
            if (temp[f] > 0) {
                temp[f]--;
                if (temp[m] > 0) {
                    temp[m]--;
                    if (temp[l] > 0) {
                        ans.push_back(i);
                    }
                }
            }
        }

        sort(ans.begin(), ans.end());
        return ans;
    }
};
