class Solution {
public:
    bool uniqueOccurrences(vector<int>& arr) {
        unordered_map<int,int>freq;
        for(int i=0;i<arr.size();i++){
            freq[arr[i]]++;
        }
        unordered_set<int>s;
        for(auto x : freq){
            int f=x.second;
            if(s.find(f)!=s.end()){
                return false;
            }
            else{
                s.insert(f);
            }
        }
        return true;
    }
};
