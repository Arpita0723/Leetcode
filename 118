class Solution {
public:
long long fact(long long a){
    if(a==0 || a==1) return 1;
    return a*fact(a-1);
}
long long permut(int n,int r){
    return fact(n)/((fact(n-r))*fact(r));
}
    vector<vector<int>> generate(int numRows) {
        vector<vector<int>> fans;
        for (int i = 0; i < numRows; i++) {
            vector<int> row(i + 1, 1); 
            for (int j = 1; j < i; j++) {
                row[j] = fans[i - 1][j - 1] + fans[i - 1][j];
            }
            fans.push_back(row);
        }
        return fans;
    }
};
