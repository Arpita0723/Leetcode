class Solution {
public:
    bool hasCycle(ListNode *head) {
        if(head==NULL)return false;
        if(head->next==NULL)return false;
        ListNode* fast=head->next;
        ListNode* slow=head;
        while(fast!=slow){
            fast=fast->next;
            slow=slow->next;
            if(fast==NULL || fast->next==NULL)return false;
            else {fast=fast->next;}
        }
        return true;
    }
};
