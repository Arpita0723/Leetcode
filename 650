class Solution {
public:
    int minSteps(int n) {
      if(n==1)return 0;
      string copy="A";
      string paste="A";
      int c=0;
      while(paste.length()!=n){
        int x=paste.length();
        if(((n-x)%x)==0){
            copy=paste;
            paste+=copy;
            c+=2;
        }
        else{
            paste+=copy;
            c+=1;
        }
      }
      return c;
    }
};
