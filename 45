class Solution {
public:
    int jump(vector<int>& nums) {
        int cnt=0; 
        int r=0;
        int l=0;
        while(r<nums.size()-1){
            int far=0;
            for(int idx=l;idx<=r;idx++){
                far=max(far,idx+nums[idx]);
            }
            l=r+1;
            r=far;
            cnt++;
        }
        return cnt;
    }
};
