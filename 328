class Solution {
public:
    ListNode* oddEvenList(ListNode* head) {
        ListNode* dummy1=new ListNode(-1);
        ListNode* dummy2=new ListNode(-1);
        ListNode* t1=dummy1;
        ListNode* t2=dummy2;
        int i=1;
        while(head!=NULL){
           if(i%2==1){
              t1->next=new ListNode(head->val);
              t1=t1->next;
              head=head->next;
           }
           if(i%2==0){
              t2->next=new ListNode(head->val);
              t2=t2->next;
              head=head->next;
           }
           i++;
        }
        t1->next=dummy2->next;
        return dummy1->next;
    }
};
