class Solution {
public:
    bool lemonadeChange(vector<int>& bills) {
        int d5=0;
        int d10=0;
        int d20=0;
        int i=0;
        while(i<bills.size()){
            if(bills[i]==5){
                d5++;
            }
            else if(bills[i]==10){
                d10++;
                if(d5>0)d5--;
                else return false;
            }
            else{
                if(d10>0){
                    d10--;
                    if(d5>0)d5--;
                    else return false;
                }
                else{
                    if(d5>=3)d5-=3;
                    else return false;
                }
            }
            i++;
        }
        return true;
    }
};
