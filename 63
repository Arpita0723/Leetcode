    int  f(int m,int n,vector<vector<int>>&arr){ 
        vector<int>prev(n,0);
        for(int i=0;i<m;i++){
            vector<int>curr(n,0);
            for(int j=0;j<n;j++){
                if(i==0 && j==0)curr[j]= (arr[0][0] == 0) ? 1 : 0;
                else if(arr[i][j]==1){
                    curr[j]=0;
                    continue;
                }
                else{
                    int up=0, left=0;
                    if(j>0 && arr[i][j-1]!=1) left=curr[j-1];
                    if(i>0 && arr[i-1][j]!=1) up=prev[j];
                    curr[j]=up+left;
                }
            }
            prev=curr;
        }
        return prev[n-1];
    }
    int uniquePathsWithObstacles(vector<vector<int>>&arr) {
        int m=arr.size();
        int n=arr[0].size();
        if(arr[m-1][n-1]==1)return 0;
        return f(m,n,arr);
    }
