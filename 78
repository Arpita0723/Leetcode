class Solution {
public:
    void helper(vector<int>& nums,int idx, vector<vector<int>>&fans,vector<int>ans){
        if(idx==nums.size()){
            fans.push_back(ans);
            return ;
        }
        helper(nums,idx+1,fans,ans);
        ans.push_back(nums[idx]);
        helper(nums,idx+1,fans,ans);
    }
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>>fans;
        vector<int>ans;
        helper(nums,0,fans,ans);
        return fans;
    }
};
